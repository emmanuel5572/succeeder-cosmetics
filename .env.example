# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string.
# Local example:  postgresql://postgres:password@localhost:5432/succeeder
# Railway provides this automatically as DATABASE_URL in the environment.
DATABASE_URL=postgresql://postgres:password@localhost:5432/succeeder

# Any long random string. Used to sign login sessions (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Port the server listens on (Railway sets this automatically)
PORT=3000

# Set to "production" when deploying (enables secure cookies over HTTPS)
NODE_ENV=development
